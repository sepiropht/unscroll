    <string name="reminders_eye_title">Eye break</string>
    <string name="reminders_eye_body">A notification after a stretch of screen time, so you can look away.</string>
    <string name="reminders_summary_title">Daily summary</string>
    <string name="reminders_summary_body">At the chosen time: today’s total, unlocks, and the app used the longest.</string>
