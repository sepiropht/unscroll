    <string name="settings_about_sub"></string>
    <string name="about_title">About</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Measurements, limits, and settings stay on this device. There is no account, no advertising, and no audience measurement. The Privacy screen says what stays here, and what can leave if you asked for it.

Usage access counts time and tells the app which application is in front, so a limit can show the pause screen. Website tracking, when you turn it on, uses an accessibility service that reads only the address bar of known browsers. It does not read messages, typing, or passwords. Nothing is sent off the device unless you turn on optional sync.</string>
    <string name="about_license_title">Licenses</string>
    <string name="about_license_body">Unscroll is distributed under the AGPL-3.0 license. AndroidX, Kotlin, Room, WorkManager, and Glance are under the Apache 2.0 license.</string>
    <string name="settings_sync">Sync</string>
    <string name="settings_sync_sub"></string>
    <string name="settings_sync_on">On</string>
    <string name="settings_sync_off">Off</string>
    <string name="sync_title">Sync</string>
    <string name="settings_privacy_sub"></string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_local_title">On this device</string>
    <string name="privacy_local_body">Measurements, limits, sites, and settings stay in the phone’s storage. There is no account. Nothing is sent to an audience, advertising, or crash service. Sync has its own screen. It stays off until you turn it on, and then sends only ciphertext to the server you choose.</string>
    <string name="privacy_access_title">What the app sees</string>
    <string name="privacy_access_body">Usage access counts screen time and is used to know which app is in front, so a limit can show the pause overlay. Website tracking is optional: the accessibility service, when you turn it on, reads only the address bar of known browsers. The app does not read messages, passwords, or what you type. Display over other apps is used only to show that pause screen.</string>
    <string name="privacy_sync_title">Sync</string>
    <string name="privacy_sync_body">The default server is https://sync.unscroll.elimbi.com. You can change it. Turning sync on with an empty token creates an anonymous account: the server stores only the hash of the token. A 32-byte key stays on the phone and encrypts end to end (AES-GCM). The server receives only ciphertext. A passphrase remains available for a vault that already uses one.</string>
    <string name="privacy_sync_enable">Turn sync on</string>
    <string name="privacy_sync_enable_sub">Off at the start. No request while it is off. Turning it on with an empty token creates the account.</string>
